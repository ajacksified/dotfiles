[alias]
  co = checkout
  ci = commit
  st = status
  br = branch
  hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
  type = cat-file -t
  dump = cat-file -p
  last = cat-file commit HEAD
  pushom = push origin master
  pullom = pull origin master
[color]
  ui = auto
[core]
  # editor comes from $EDITOR (nvim, or vim if nvim isn't installed)
  excludesfile = ~/.gitignore
[init]
  defaultBranch = main
[push]
  autoSetupRemote = true
[fetch]
  prune = true
[diff]
  algorithm = histogram

# Name, email, and signing live in ~/.gitconfig.local (created by link.sh,
# never committed). Keep this last so local settings win.
[include]
  path = ~/.gitconfig.local
